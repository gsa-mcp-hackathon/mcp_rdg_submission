# Reference only: apps and launchers do not automatically load this file.
# Set these in your shell or deployment environment. Never commit real values.
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_WAREHOUSE_ID=your-warehouse-id
DATABRICKS_CONFIG_PROFILE=rdg-local
MCP_SERVER_URL=http://127.0.0.1:8000/mcp
SERVING_ENDPOINT=databricks-claude-sonnet-5

# The separate stdio catalog browser requires these instead of a warehouse ID.
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/your-warehouse-id
# Prefer CLI OAuth for local chat. Supply a token privately only when required.
DATABRICKS_TOKEN=

# Cluster notebook: secret reference names, not the token itself.
DATABRICKS_SECRET_SCOPE=your-secret-scope
DATABRICKS_TOKEN_SECRET_KEY=your-token-secret-key